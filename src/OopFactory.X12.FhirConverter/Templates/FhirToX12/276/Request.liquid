{%- comment -%}
FHIR Claim (status inquiry) → X12 276 Claim Status Request
{%- endcomment -%}
{%- assign claim = nil -%}
{%- assign patient = nil -%}
{%- assign payer_org = nil -%}
{%- assign provider = nil -%}
{%- for entry_item in entry -%}
  {%- assign res = entry_item.resource -%}
  {%- if res.resourceType == "Claim" -%}{%- assign claim = res -%}{%- endif -%}
  {%- if res.resourceType == "Patient" -%}{%- assign patient = res -%}{%- endif -%}
  {%- if res.resourceType == "Organization" -%}{%- assign payer_org = res -%}{%- endif -%}
  {%- if res.resourceType == "Practitioner" -%}{%- assign provider = res -%}{%- endif -%}
{%- endfor -%}
{%- assign today_x12 = claim.created | fhir_date_to_x12 -%}
{%- assign isa_control = claim.id | truncate: 9, "" -%}
ISA*00*          *00*          *ZZ*SENDER         *ZZ*RECEIVER       *{{ today_x12 | truncate: 6, "" }}*1200*^*00501*{{ isa_control | rjust: 9, "0" }}*0*P*:~
GS*HR*SENDER*RECEIVER*{{ today_x12 }}*1200*{{ isa_control }}*X*005010X212~
ST*276*0001*005010X212~
BHT*0010*13*{{ claim.id }}*{{ today_x12 }}*1200~
HL*1**20*1~
NM1*PR*2*{{ payer_org.name }}*****PI*{{ payer_org.identifier[0].value }}~
HL*2*1*21*1~
NM1*1P*1*{{ provider.name[0].family }}*{{ provider.name[0].given[0] }}****XX*{{ provider.identifier[0].value }}~
HL*3*2*22*0~
NM1*IL*1*{{ patient.name[0].family }}*{{ patient.name[0].given[0] }}****MI*{{ patient.identifier[0].value }}~
{%- for ident in claim.identifier -%}
TRN*1*{{ ident.value }}*{{ isa_control | rjust: 10, "0" }}~
{%- endfor -%}
{%- if claim.billablePeriod -%}
DTP*472*RD8*{{ claim.billablePeriod.start | fhir_date_to_x12 }}-{{ claim.billablePeriod.end | fhir_date_to_x12 }}~
{%- endif -%}
SE*placeholder*0001~
GE*1*{{ isa_control }}~
IEA*1*{{ isa_control | rjust: 9, "0" }}~
