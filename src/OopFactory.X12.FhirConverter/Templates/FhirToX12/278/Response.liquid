{%- comment -%}
FHIR ClaimResponse → X12 278 Prior Authorization Response
Input: FHIR Bundle with ClaimResponse, Patient, Organization
Output: X12 EDI 278 Response
{%- endcomment -%}
{%- assign claim_response = nil -%}
{%- assign patient = nil -%}
{%- assign insurer_org = nil -%}
{%- assign provider_prac = nil -%}
{%- for entry_item in entry -%}
  {%- assign res = entry_item.resource -%}
  {%- if res.resourceType == "ClaimResponse" -%}{%- assign claim_response = res -%}{%- endif -%}
  {%- if res.resourceType == "Patient" -%}{%- assign patient = res -%}{%- endif -%}
  {%- if res.resourceType == "Organization" -%}{%- assign insurer_org = res -%}{%- endif -%}
  {%- if res.resourceType == "Practitioner" -%}{%- assign provider_prac = res -%}{%- endif -%}
{%- endfor -%}
{%- assign today_x12 = claim_response.created | fhir_date_to_x12 -%}
{%- assign isa_control = claim_response.id | truncate: 9, "" -%}
{%- assign gs_control = claim_response.id | truncate: 9, "" -%}
{%- assign st_control = "0001" -%}
ISA*00*          *00*          *ZZ*SENDER         *ZZ*RECEIVER       *{{ today_x12 | truncate: 6, "" }}*1200*^*00501*{{ isa_control | rjust: 9, "0" }}*0*P*:~
GS*HI*SENDER*RECEIVER*{{ today_x12 }}*1200*{{ gs_control }}*X*005010X217~
ST*278*{{ st_control }}*005010X217~
BHT*0007*11*{{ claim_response.id }}*{{ today_x12 }}*1200*18~
HL*1**20*1~
NM1*X3*2*{{ insurer_org.name }}*****46*{{ insurer_org.identifier[0].value }}~
HL*2*1*21*1~
{%- if provider_prac -%}
NM1*1P*1*{{ provider_prac.name[0].family }}*{{ provider_prac.name[0].given[0] }}****46*{{ provider_prac.identifier[0].value }}~
{%- endif -%}
HL*3*2*22*1~
NM1*IL*1*{{ patient.name[0].family }}*{{ patient.name[0].given[0] }}****MI*{{ patient.identifier[0].value }}~
HL*4*3*EV*0~
{%- for ident in claim_response.identifier -%}
TRN*2*{{ ident.value }}*{{ isa_control | rjust: 10, "0" }}~
{%- endfor -%}
UM*{{ claim_response.item[0].productOrService.coding[0].code | default: "SC" }}*I*3~
{%- assign outcome_code = claim_response.outcome | fhir_code_to_x12: 'PriorAuthDecision' -%}
HCR*{{ outcome_code }}*{{ claim_response.preAuthRef }}~
SE*{{ "placeholder" }}*{{ st_control }}~
GE*1*{{ gs_control }}~
IEA*1*{{ isa_control | rjust: 9, "0" }}~
