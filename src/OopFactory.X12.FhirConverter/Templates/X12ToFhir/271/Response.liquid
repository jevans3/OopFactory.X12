{
  "resourceType": "Bundle",
  "id": "{{ interchange_control_number | append: '-' | append: transaction_control_number }}",
  "type": "collection",
  "entry": [
    {%- for hloop in hierarchical_loops -%}
      {%- if hloop.level_code == "20" -%}
        {%- assign payer_nm1 = hloop.nm1_PR -%}
        {%- if payer_nm1 == nil -%}{%- assign payer_nm1 = hloop.nm1_X3 -%}{%- endif -%}
        {%- assign payer_id = payer_nm1.e09 -%}
        {%- assign payer_uuid = "Organization" | generate_uuid: payer_id -%}
    {
      "fullUrl": "urn:uuid:{{ payer_uuid }}",
      "resource": {
        "resourceType": "Organization",
        "id": "{{ payer_uuid }}",
        "name": "{{ payer_nm1.e03 | escape_json }}",
        "identifier": [{ "value": "{{ payer_id }}" }]
      }
    },
        {%- for child_21 in hloop.children -%}
          {%- if child_21.level_code == "21" -%}
            {%- assign src_nm1 = child_21.nm1_1P -%}
            {%- if src_nm1 == nil -%}{%- assign src_nm1 = child_21.nm1_FA -%}{%- endif -%}
            {%- assign src_id = src_nm1.e09 -%}
            {%- assign src_uuid = "Practitioner" | generate_uuid: src_id -%}
    {
      "fullUrl": "urn:uuid:{{ src_uuid }}",
      "resource": {
        "resourceType": "Practitioner",
        "id": "{{ src_uuid }}",
        "identifier": [{ "system": "http://hl7.org/fhir/sid/us-npi", "value": "{{ src_id }}" }],
        "name": [{ "family": "{{ src_nm1.e03 | escape_json }}", "given": ["{{ src_nm1.e04 | escape_json }}"] }]
      }
    },
            {%- for child_22 in child_21.children -%}
              {%- if child_22.level_code == "22" -%}
                {%- assign sub_nm1 = child_22.nm1_IL -%}
                {%- assign sub_id = sub_nm1.e09 -%}
                {%- assign patient_uuid = "Patient" | generate_uuid: sub_id -%}
                {%- assign coverage_uuid = "Coverage" | generate_uuid: sub_id -%}
                {%- assign cer_uuid = "CoverageEligibilityResponse" | generate_uuid: sub_id -%}
    {
      "fullUrl": "urn:uuid:{{ patient_uuid }}",
      "resource": {
        "resourceType": "Patient",
        "id": "{{ patient_uuid }}",
        "identifier": [{ "system": "http://hl7.org/fhir/sid/us-medicare", "value": "{{ sub_id }}" }],
        "name": [{ "family": "{{ sub_nm1.e03 | escape_json }}", "given": ["{{ sub_nm1.e04 | escape_json }}"] }]
        {%- if child_22.dmg -%}
        ,"birthDate": "{{ child_22.dmg.e02 | x12_date }}"
        ,"gender": "{{ child_22.dmg.e03 | x12_gender }}"
        {%- endif -%}
      }
    },
    {
      "fullUrl": "urn:uuid:{{ cer_uuid }}",
      "resource": {
        "resourceType": "CoverageEligibilityResponse",
        "id": "{{ cer_uuid }}",
        "status": "active",
        "purpose": ["validation"],
        "patient": { "reference": "urn:uuid:{{ patient_uuid }}" },
        "created": "{{ bht.e04 | x12_date }}",
        "insurer": { "reference": "urn:uuid:{{ payer_uuid }}" },
        "outcome": "complete"
        {%- if child_22.eb_list -%}
        ,"insurance": [{
          "coverage": { "reference": "urn:uuid:{{ coverage_uuid }}" },
          "inforce": true,
          "item": [
            {%- for eb in child_22.eb_list -%}
            {
              "category": { "coding": [{ "system": "https://x12.org/codes/service-type-codes", "code": "{{ eb.e03 }}" }] },
              "description": "{{ eb.e01 | x12_code_to_fhir: 'ServiceTypeCode' }}"
              {%- if eb.e06 -%}
              ,"benefit": [{
                "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/benefit-type", "code": "benefit" }] },
                "allowedMoney": { "value": {{ eb.e06 }}, "currency": "USD" }
              }]
              {%- endif -%}
            }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }]
        {%- endif -%}
      }
    }
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
