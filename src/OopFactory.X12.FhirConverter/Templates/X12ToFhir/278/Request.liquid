{
  "resourceType": "Bundle",
  "id": "{{ interchange_control_number | append: '-' | append: transaction_control_number }}",
  "type": "collection",
  "timestamp": "{{ interchange_date | x12_date }}T00:00:00Z",
  "meta": {
    "profile": ["http://hl7.org/fhir/us/davinci-pas/StructureDefinition/profile-pas-request-bundle"]
  },
  "entry": [
    {%- comment %} Build Claim resource from the event-level HL loop {% endcomment -%}
    {%- for hloop in hierarchical_loops -%}
      {%- if hloop.level_code == "20" -%}
        {%- comment %} Information Source (Payer) {% endcomment -%}
        {%- assign payer_nm1 = hloop.nm1_X3 -%}
        {%- if payer_nm1 == nil -%}{%- assign payer_nm1 = hloop.nm1_PR -%}{%- endif -%}
        {%- assign payer_name = payer_nm1.e03 -%}
        {%- assign payer_id = payer_nm1.e09 -%}
        {%- assign payer_uuid = "Organization" | generate_uuid: payer_id -%}
        {
          "fullUrl": "urn:uuid:{{ payer_uuid }}",
          "resource": {
            "resourceType": "Organization",
            "id": "{{ payer_uuid }}",
            "identifier": [{ "system": "https://x12.org/codes/entity-identifier", "value": "{{ payer_id }}" }],
            "name": "{{ payer_name | escape_json }}",
            "type": [{ "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/organization-type", "code": "pay", "display": "Payer" }] }]
          }
        },
        {%- for child_21 in hloop.children -%}
          {%- if child_21.level_code == "21" -%}
            {%- comment %} Information Receiver (Provider) {% endcomment -%}
            {%- assign prov_nm1 = child_21.nm1_1P -%}
            {%- if prov_nm1 == nil -%}{%- assign prov_nm1 = child_21.nm1_FA -%}{%- endif -%}
            {%- assign prov_last = prov_nm1.e03 -%}
            {%- assign prov_first = prov_nm1.e04 -%}
            {%- assign prov_id = prov_nm1.e09 -%}
            {%- assign prov_uuid = "Practitioner" | generate_uuid: prov_id -%}
        {
          "fullUrl": "urn:uuid:{{ prov_uuid }}",
          "resource": {
            "resourceType": "Practitioner",
            "id": "{{ prov_uuid }}",
            "identifier": [{ "system": "http://hl7.org/fhir/sid/us-npi", "value": "{{ prov_id }}" }],
            "name": [{ "family": "{{ prov_last | escape_json }}", "given": ["{{ prov_first | escape_json }}"] }]
          }
        },
            {%- for child_22 in child_21.children -%}
              {%- if child_22.level_code == "22" -%}
                {%- comment %} Subscriber {% endcomment -%}
                {%- assign sub_nm1 = child_22.nm1_IL -%}
                {%- if sub_nm1 == nil -%}{%- assign sub_nm1 = child_22.nm1_QC -%}{%- endif -%}
                {%- assign sub_last = sub_nm1.e03 -%}
                {%- assign sub_first = sub_nm1.e04 -%}
                {%- assign sub_member_id = sub_nm1.e09 -%}
                {%- assign patient_uuid = "Patient" | generate_uuid: sub_member_id -%}
                {%- assign coverage_uuid = "Coverage" | generate_uuid: sub_member_id -%}
        {
          "fullUrl": "urn:uuid:{{ patient_uuid }}",
          "resource": {
            "resourceType": "Patient",
            "id": "{{ patient_uuid }}",
            "identifier": [{ "system": "http://hl7.org/fhir/sid/us-medicare", "value": "{{ sub_member_id }}" }],
            "name": [{ "family": "{{ sub_last | escape_json }}", "given": ["{{ sub_first | escape_json }}"] }]
            {%- if child_22.dmg -%}
            ,"birthDate": "{{ child_22.dmg.e02 | x12_date }}"
            ,"gender": "{{ child_22.dmg.e03 | x12_gender }}"
            {%- endif -%}
          }
        },
        {
          "fullUrl": "urn:uuid:{{ coverage_uuid }}",
          "resource": {
            "resourceType": "Coverage",
            "id": "{{ coverage_uuid }}",
            "status": "active",
            "subscriber": { "reference": "urn:uuid:{{ patient_uuid }}" },
            "beneficiary": { "reference": "urn:uuid:{{ patient_uuid }}" },
            "payor": [{ "reference": "urn:uuid:{{ payer_uuid }}" }],
            "subscriberId": "{{ sub_member_id }}"
          }
        },
                {%- for child_ev in child_22.children -%}
                  {%- if child_ev.level_code == "EV" -%}
                    {%- comment %} Event - Prior Authorization Claim {% endcomment -%}
                    {%- assign trn = child_ev.trn -%}
                    {%- assign um = child_ev.um -%}
                    {%- assign claim_uuid = "Claim" | generate_uuid: trn.e02 -%}
                    {%- assign sr_uuid = "ServiceRequest" | generate_uuid: trn.e02 -%}
        {
          "fullUrl": "urn:uuid:{{ sr_uuid }}",
          "resource": {
            "resourceType": "ServiceRequest",
            "id": "{{ sr_uuid }}",
            "status": "active",
            "intent": "order",
            "subject": { "reference": "urn:uuid:{{ patient_uuid }}" },
            "requester": { "reference": "urn:uuid:{{ prov_uuid }}" }
            {%- if um -%}
            ,"category": [{ "coding": [{ "system": "https://x12.org/codes/service-type-codes", "code": "{{ um.e01 }}", "display": "{{ um.e01 | x12_code_to_fhir: 'ServiceTypeCode' }}" }] }]
            {%- endif -%}
            {%- if child_ev.hi_list -%}
            ,"reasonCode": [
              {%- for hi in child_ev.hi_list -%}
              {%- assign hi_qual = hi.e01 | sub_element: 1 -%}
              {%- assign hi_code = hi.e01 | sub_element: 2 -%}
              { "coding": [{ "system": "{{ hi_qual | diagnosis_code_system }}", "code": "{{ hi_code }}" }] }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
            {%- endif -%}
          }
        },
        {
          "fullUrl": "urn:uuid:{{ claim_uuid }}",
          "resource": {
            "resourceType": "Claim",
            "id": "{{ claim_uuid }}",
            "status": "active",
            "use": "preauthorization",
            "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/claim-type", "code": "professional" }] },
            "patient": { "reference": "urn:uuid:{{ patient_uuid }}" },
            "created": "{{ bht.e04 | x12_date }}",
            "provider": { "reference": "urn:uuid:{{ prov_uuid }}" },
            "insurer": { "reference": "urn:uuid:{{ payer_uuid }}" },
            "priority": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/processpriority", "code": "normal" }] },
            "insurance": [{ "sequence": 1, "focal": true, "coverage": { "reference": "urn:uuid:{{ coverage_uuid }}" } }],
            "identifier": [{ "system": "https://x12.org/codes/trn", "value": "{{ trn.e02 }}" }]
            {%- if child_ev.hi_list -%}
            ,"diagnosis": [
              {%- for hi in child_ev.hi_list -%}
              {%- assign hi_qual = hi.e01 | sub_element: 1 -%}
              {%- assign hi_code = hi.e01 | sub_element: 2 -%}
              { "sequence": {{ forloop.index }}, "diagnosisCodeableConcept": { "coding": [{ "system": "{{ hi_qual | diagnosis_code_system }}", "code": "{{ hi_code }}" }] } }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
            {%- endif -%}
            ,"item": [{
              "sequence": 1,
              "productOrService": { "coding": [{ "system": "https://x12.org/codes/service-type-codes", "code": "{{ um.e01 }}" }] }
              {%- if um.e04 -%}
              ,"locationCodeableConcept": { "coding": [{ "system": "https://www.cms.gov/Medicare/Coding/place-of-service-codes/Place_of_Service_Code_Set", "code": "{{ um.e04 | sub_element: 1 }}" }] }
              {%- endif -%}
              {%- if child_ev.hsd -%}
              ,"quantity": { "value": {{ child_ev.hsd.e02 | default: 1 }} }
              {%- endif -%}
            }]
            ,"supportingInfo": [
              {
                "sequence": 1,
                "category": { "coding": [{ "system": "http://hl7.org/fhir/us/davinci-pas/CodeSystem/PASSupportingInfoType", "code": "patientEvent" }] },
                "code": { "coding": [{ "system": "https://x12.org/codes/certification-type-codes", "code": "{{ um.e02 }}" }] }
              }
            ]
          }
        }
                    {%- comment %} Rendering/Servicing provider at event level {% endcomment -%}
                    {%- if child_ev.nm1_SJ -%}
                    {%- assign svc_prov_id = child_ev.nm1_SJ.e09 -%}
                    {%- assign svc_prov_uuid = "Practitioner" | generate_uuid: svc_prov_id -%}
        ,{
          "fullUrl": "urn:uuid:{{ svc_prov_uuid }}",
          "resource": {
            "resourceType": "Practitioner",
            "id": "{{ svc_prov_uuid }}",
            "identifier": [{ "system": "http://hl7.org/fhir/sid/us-npi", "value": "{{ svc_prov_id }}" }],
            "name": [{ "family": "{{ child_ev.nm1_SJ.e03 | escape_json }}", "given": ["{{ child_ev.nm1_SJ.e04 | escape_json }}"] }]
          }
        }
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
