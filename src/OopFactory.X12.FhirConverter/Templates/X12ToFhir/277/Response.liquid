{
  "resourceType": "Bundle",
  "id": "{{ interchange_control_number | append: '-' | append: transaction_control_number }}",
  "type": "collection",
  "entry": [
    {%- for hloop in hierarchical_loops -%}
      {%- if hloop.level_code == "20" -%}
        {%- assign payer_nm1 = hloop.nm1_PR -%}
        {%- if payer_nm1 == nil -%}{%- assign payer_nm1 = hloop.nm1_X3 -%}{%- endif -%}
        {%- assign payer_uuid = "Organization" | generate_uuid: payer_nm1.e09 -%}
    {
      "fullUrl": "urn:uuid:{{ payer_uuid }}",
      "resource": {
        "resourceType": "Organization",
        "id": "{{ payer_uuid }}",
        "name": "{{ payer_nm1.e03 | escape_json }}",
        "identifier": [{ "value": "{{ payer_nm1.e09 }}" }]
      }
    },
        {%- for child_21 in hloop.children -%}
          {%- if child_21.level_code == "21" -%}
            {%- for child_22 in child_21.children -%}
              {%- if child_22.level_code == "22" -%}
                {%- assign sub_nm1 = child_22.nm1_IL -%}
                {%- assign patient_uuid = "Patient" | generate_uuid: sub_nm1.e09 -%}
                {%- assign cr_uuid = "ClaimResponse" | generate_uuid: sub_nm1.e09 -%}
    {
      "fullUrl": "urn:uuid:{{ patient_uuid }}",
      "resource": {
        "resourceType": "Patient",
        "id": "{{ patient_uuid }}",
        "identifier": [{ "value": "{{ sub_nm1.e09 }}" }],
        "name": [{ "family": "{{ sub_nm1.e03 | escape_json }}", "given": ["{{ sub_nm1.e04 | escape_json }}"] }]
      }
    },
    {
      "fullUrl": "urn:uuid:{{ cr_uuid }}",
      "resource": {
        "resourceType": "ClaimResponse",
        "id": "{{ cr_uuid }}",
        "status": "active",
        "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/claim-type", "code": "professional" }] },
        "use": "claim",
        "patient": { "reference": "urn:uuid:{{ patient_uuid }}" },
        "insurer": { "reference": "urn:uuid:{{ payer_uuid }}" },
        "created": "{{ bht.e04 | x12_date }}",
        "outcome": "queued"
        {%- if child_22.trn -%}
        ,"identifier": [{ "system": "https://x12.org/codes/trn", "value": "{{ child_22.trn.e02 }}" }]
        {%- endif -%}
        {%- if child_22.stc_list -%}
        ,"processNote": [
          {%- for stc in child_22.stc_list -%}
          {
            "number": {{ forloop.index }},
            "type": "display",
            "text": "Status: {{ stc.e01 | sub_element: 1 }} - {{ stc.e01 | sub_element: 2 }} ({{ stc.e01 | sub_element: 3 }})"
          }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
        {%- endif -%}
        {%- if child_22.dtp_list -%}
        ,"extension": [{
          "url": "http://hl7.org/fhir/us/davinci-pas/StructureDefinition/extension-reviewActionDate",
          {%- for dtp in child_22.dtp_list -%}
          "valueDate": "{{ dtp.e03 | x12_date }}"
          {%- endfor -%}
        }]
        {%- endif -%}
      }
    }
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
