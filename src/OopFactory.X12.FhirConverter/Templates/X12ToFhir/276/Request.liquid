{
  "resourceType": "Bundle",
  "id": "{{ interchange_control_number | append: '-' | append: transaction_control_number }}",
  "type": "collection",
  "entry": [
    {%- for hloop in hierarchical_loops -%}
      {%- if hloop.level_code == "20" -%}
        {%- assign payer_nm1 = hloop.nm1_PR -%}
        {%- if payer_nm1 == nil -%}{%- assign payer_nm1 = hloop.nm1_X3 -%}{%- endif -%}
        {%- assign payer_uuid = "Organization" | generate_uuid: payer_nm1.e09 -%}
    {
      "fullUrl": "urn:uuid:{{ payer_uuid }}",
      "resource": {
        "resourceType": "Organization",
        "id": "{{ payer_uuid }}",
        "name": "{{ payer_nm1.e03 | escape_json }}",
        "identifier": [{ "value": "{{ payer_nm1.e09 }}" }]
      }
    },
        {%- for child_21 in hloop.children -%}
          {%- if child_21.level_code == "21" -%}
            {%- assign prov_nm1 = child_21.nm1_1P -%}
            {%- assign prov_uuid = "Practitioner" | generate_uuid: prov_nm1.e09 -%}
    {
      "fullUrl": "urn:uuid:{{ prov_uuid }}",
      "resource": {
        "resourceType": "Practitioner",
        "id": "{{ prov_uuid }}",
        "identifier": [{ "system": "http://hl7.org/fhir/sid/us-npi", "value": "{{ prov_nm1.e09 }}" }],
        "name": [{ "family": "{{ prov_nm1.e03 | escape_json }}", "given": ["{{ prov_nm1.e04 | escape_json }}"] }]
      }
    },
            {%- for child_22 in child_21.children -%}
              {%- if child_22.level_code == "22" -%}
                {%- assign sub_nm1 = child_22.nm1_IL -%}
                {%- assign patient_uuid = "Patient" | generate_uuid: sub_nm1.e09 -%}
                {%- assign claim_uuid = "Claim" | generate_uuid: sub_nm1.e09 -%}
    {
      "fullUrl": "urn:uuid:{{ patient_uuid }}",
      "resource": {
        "resourceType": "Patient",
        "id": "{{ patient_uuid }}",
        "identifier": [{ "system": "http://hl7.org/fhir/sid/us-medicare", "value": "{{ sub_nm1.e09 }}" }],
        "name": [{ "family": "{{ sub_nm1.e03 | escape_json }}", "given": ["{{ sub_nm1.e04 | escape_json }}"] }]
      }
    },
    {
      "fullUrl": "urn:uuid:{{ claim_uuid }}",
      "resource": {
        "resourceType": "Claim",
        "id": "{{ claim_uuid }}",
        "status": "active",
        "use": "claim",
        "type": { "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/claim-type", "code": "professional" }] },
        "patient": { "reference": "urn:uuid:{{ patient_uuid }}" },
        "provider": { "reference": "urn:uuid:{{ prov_uuid }}" },
        "insurer": { "reference": "urn:uuid:{{ payer_uuid }}" },
        "created": "{{ bht.e04 | x12_date }}"
        {%- if child_22.trn -%}
        ,"identifier": [{ "system": "https://x12.org/codes/trn", "value": "{{ child_22.trn.e02 }}" }]
        {%- endif -%}
        {%- if child_22.ref_list -%}
        ,"supportingInfo": [
          {%- for ref_seg in child_22.ref_list -%}
          {
            "sequence": {{ forloop.index }},
            "category": { "coding": [{ "system": "https://x12.org/codes/reference-identification-qualifier", "code": "{{ ref_seg.e01 }}" }] },
            "valueString": "{{ ref_seg.e02 }}"
          }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
        {%- endif -%}
        {%- if child_22.dtp_list -%}
        ,"billablePeriod": {
          {%- for dtp in child_22.dtp_list -%}
            {%- if dtp.e02 == "RD8" -%}
          "start": "{{ dtp.e03 | x12_date_range_start }}",
          "end": "{{ dtp.e03 | x12_date_range_end }}"
            {%- else -%}
          "start": "{{ dtp.e03 | x12_date }}"
            {%- endif -%}
          {%- endfor -%}
        }
        {%- endif -%}
      }
    }
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
